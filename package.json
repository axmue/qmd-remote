{
  "name": "qmd-remote",
  "version": "0.1.0",
  "description": "Remote model backend for qmd: point embed / rerank / query-expansion at OpenAI-compatible or Ollama endpoints. Run qmd's indexer and hybrid search on any machine — no GGUF downloads.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "qmd-remote": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'tests/*.test.ts'",
    "check:mcp-drift": "node scripts/check-mcp-drift.mjs",
    "test:consumer": "node scripts/consumer-test.mjs",
    "check": "npm run typecheck && npm run check:mcp-drift && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@tobilu/qmd": "2.9.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-llama-cpp@3.22.3": true
  }
}
